{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/blog/pact",
      "destination": "/blog/pact/index.html"
    },
    {
      "source": "/connect",
      "destination": "/connect/index.html"
    },
    {
      "source": "/r/:token",
      "destination": "/api/r/:token"
    },
    {
      "source": "/notes",
      "destination": "/notes/index.html"
    },
    {
      "source": "/notes/:id",
      "destination": "/notes/:id/index.html"
    },
    {
      "source": "/ey-internship",
      "destination": "/ey-internship/index.html"
    },
    {
      "source": "/preview/contributions",
      "destination": "/preview/contributions/index.html"
    }
  ],
  "trailingSlash": false
}
